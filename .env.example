# Environment variables for LOCAL DEVELOPMENT only
# Copy this file to .env and fill in values
# .env is git-ignored — never commit real credentials

# ───────────────────────────────────────────────
# LOCAL DEV (dev profile uses H2, no secrets needed)
# Uncomment only if you want to override defaults
# ───────────────────────────────────────────────

# Activate dev profile (default, H2 in-memory)
# SPRING_PROFILES_ACTIVE=dev

# JWT secret for local dev (the default is fine for dev only)
# JWT_SECRET=dev-only-change-me-to-a-long-enough-secret-key-for-hs256-checkers-online

# Site base URL for local dev
# SITE_BASE_URL=http://localhost:8080

# ───────────────────────────────────────────────
# PRODUCTION — These go in Render Dashboard or render.yaml
# Never put real values here in .env.example
# ───────────────────────────────────────────────

# SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/checkers  (Render injects this automatically)
# JWT_SECRET=<generate with: openssl rand -base64 64>
# SITE_BASE_URL=https://your-app-name.onrender.com
# Optional on Render: defaults to the real RENDER_EXTERNAL_URL.
# For a custom domain, use its HTTPS origin without path/query; do not set a blank value.
# SITE_INDEXING_ENABLED=false  # use on staging; dev/localhost always block indexing
# GOOGLE_SITE_VERIFICATION=<content value from Google Search Console HTML meta tag>
# BING_SITE_VERIFICATION=<content value from Bing Webmaster Tools HTML meta tag>
# ASSISTANT_LLM_API_KEY=<your LLM key if using llm provider>
